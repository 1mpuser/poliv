# Адрес сайта: домен или домен:порт. Порт должен совпадать с HTTPS_PORT.
# Локально: localhost или polivalochka.cool:1477 (+ запись в /etc/hosts), в проде — реальный домен.
DOMAIN=localhost
# Порт HTTPS, публикуемый наружу
HTTPS_PORT=443
# internal — сертификат от локального CA Caddy (локальная разработка, закрытая сеть);
# email (you@example.com) — сертификат Let's Encrypt для публичного домена
TLS=internal

# Часовой пояс: границы «сегодня» и недель считаются в нём
TZ=Europe/Moscow

# PostgreSQL
POSTGRES_DB=poliv
POSTGRES_USER=poliv
POSTGRES_PASSWORD=change-me-db-password

# Секрет подписи JWT: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRE_DAYS=30
