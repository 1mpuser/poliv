{$DOMAIN} {
	# internal — сертификат от локального CA Caddy; email — Let's Encrypt для публичного домена
	tls {$TLS:internal}

	encode zstd gzip

	# SPA и /api: nginx в poliv-web сам проксирует /api на backend —
	# одна точка входа, как за Caddy трекера на сервере
	reverse_proxy poliv-web:80

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
}
